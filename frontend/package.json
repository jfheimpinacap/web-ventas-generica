{
  "name": "web-ventas-generica-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir .prerender-server --emptyOutDir",
    "prerender": "node scripts/prerender.mjs",
    "validate:prerender": "node scripts/validate-prerender.mjs",
    "build": "tsc -b && npm run build:client && npm run build:server && npm run prerender && npm run validate:prerender",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.6.2",
    "vite": "^6.4.3"
  }
}
