{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "$id": "https://schemas.jem-nexus.invalid/catalog-pipeline/v1/normalized-product.schema.json",
  "title": "normalized-product",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "canonical_identity_value": {
      "type": "string"
    },
    "values": {
      "type": "array",
      "items": {
        "$ref": "normalized-value.schema.json"
      }
    },
    "readiness": {
      "enum": [
        "blocked",
        "pending_review",
        "ready"
      ]
    },
    "type_mapping_approved": {
      "type": "boolean"
    },
    "category_mapping_approved": {
      "type": "boolean"
    },
    "blocking_issue_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "canonical_identity_value",
    "values",
    "readiness",
    "type_mapping_approved",
    "category_mapping_approved",
    "blocking_issue_codes"
  ],
  "additionalProperties": false
}
