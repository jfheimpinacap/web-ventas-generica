{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "$id": "https://schemas.jem-nexus.invalid/catalog-pipeline/v1/jem-projection.schema.json",
  "title": "jem-projection",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "canonical_identity_value": {
      "type": "string"
    },
    "structured_fields": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {},
        "slug": {},
        "category_id": {},
        "brand_id": {},
        "supplier_id": {},
        "technical_sheet": {},
        "product_type": {},
        "condition": {},
        "short_description": {},
        "description": {},
        "model": {},
        "sku": {},
        "working_height_m": {},
        "terrain_type": {},
        "year": {},
        "hours_meter": {},
        "maximum_load_capacity_kg": {},
        "machine_weight_kg": {},
        "power_source": {},
        "includes_technical_review": {},
        "includes_commercial_technical_advice": {},
        "includes_coordinated_delivery": {},
        "price": {},
        "price_currency": {},
        "price_tax_mode": {},
        "price_visible": {},
        "stock_status": {},
        "is_featured": {},
        "is_published": {}
      }
    },
    "product_specs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "key",
          "value",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "audit-issue.schema.json"
      }
    },
    "ready": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "canonical_identity_value",
    "structured_fields",
    "product_specs",
    "issues",
    "ready"
  ],
  "additionalProperties": false
}
