{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://catalog.local/schemas/v1/package-receipt.schema.json","title":"package-receipt","type":"object","additionalProperties":false,"required":["schema_version","package_path","zip_sha256","zip_size","content_fingerprint","manifest_fingerprint","plan_fingerprint","audit_fingerprint","entry_count","product_count","build_status","import_authorized","receipt_fingerprint"],"properties":{"schema_version":{"const":"1.0.0"},"package_path":{"type":"string"},"zip_sha256":{"$ref":"common-definitions.schema.json#/$defs/sha256"},"zip_size":{"type":"integer","minimum":1},"content_fingerprint":{"$ref":"common-definitions.schema.json#/$defs/sha256"},"manifest_fingerprint":{"$ref":"common-definitions.schema.json#/$defs/sha256"},"plan_fingerprint":{"$ref":"common-definitions.schema.json#/$defs/sha256"},"audit_fingerprint":{"$ref":"common-definitions.schema.json#/$defs/sha256"},"entry_count":{"type":"integer","minimum":1},"product_count":{"type":"integer","minimum":1},"build_status":{"enum":["completed","already_complete"]},"import_authorized":{"const":false},"receipt_fingerprint":{"$ref":"common-definitions.schema.json#/$defs/sha256"}}}
