{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"matching-manifest.schema.json","type":"object","additionalProperties":false,"required":["schema_version","rules_version","engine_version","input_hashes","output_hashes","rules","sources","universes","source_mappings","supplemental_entry_mappings","status","blocking_reasons","artifacts","semantic_fingerprint","generated_at"],"properties":{"schema_version":{"const":"1.0.0"},"rules_version":{"type":"string","minLength":1},"engine_version":{"const":"catalog-identity-v1"},"input_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"output_hashes":{"type":"object","additionalProperties":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"rules":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["rule_id","version"],"properties":{"rule_id":{"type":"string","minLength":1},"version":{"type":"string","minLength":1}}}},"sources":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["source","role","adapter_version"],"properties":{"source":{"type":"string","minLength":1},"role":{"enum":["authoritative_existence","supplemental"]},"adapter_version":{"type":"string","minLength":1}}}},"universes":{"type":"object","additionalProperties":false,"required":["source_identity_universe","supplemental_association_universe","discovered_universe","canonical_candidate_universe","resolved_canonical_universe","importable_universe","blocked"],"properties":{"source_identity_universe":{"type":"integer","minimum":0},"supplemental_association_universe":{"type":"integer","minimum":0},"discovered_universe":{"type":"integer","minimum":0},"canonical_candidate_universe":{"type":"integer","minimum":0},"resolved_canonical_universe":{"type":"integer","minimum":0},"importable_universe":{"const":0},"blocked":{"type":"integer","minimum":0}}},"source_mappings":{"type":"object","additionalProperties":{"type":["string","null"]}},"supplemental_entry_mapping