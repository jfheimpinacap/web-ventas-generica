{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"matching-manifest.schema.json","type":"object","additionalProperties":false,"required":["schema_version","rules_version","engine_version","binding_contract_version","binding_hash","identity_bindings","input_hashes","output_hashes","rules","sources","universes","source_mappings","supplemental_entry_mappings","status","blocking_reasons","artifacts","semantic_fingerprint","generated_at"],"properties":{"schema_version":{"const":"1.0.0"},"rules_version":{"type":"string"},"engine_version":{"const":"catalog-identity-v1"},"binding_contract_version":{"const":"matching-extraction-binding-v1"},"binding_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"identity_bindings":{"type":"array","uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["observed_identity_reference","source_identity_value","source_namespace","source_role","canonical_identity_value","evidence_references"],"properties":{"observed_identity_reference":{"type":"string"},"source_identity_value":{"type":"string","pattern":"^source-identity-v1:sha256:[0-9a-f]{64}$"},"source_namespace":{"type":"string"},"source_role":{"enum":["authoritative_existence","supplemental"]},"canonical_identity_value":{"type":["string","null"]},"evidence_references":{"type":"array","items":{"type":"string"}}}}},"input_hashes":{"type":"object"},"output_hashes":{"type":"object"},"rules":{"type":"array"},"sources":{"type":"array"},"universes":{"type":"object"},"source_mappings":{"type":"object"},"supplemental_entry_mappings":{"type":"object"},"status":{"enum":["complete","blocked"]},"blocking_reasons":{"type":"array"},"artifacts":{"type":"array"},"semantic_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"generated_at":{"type":["string","null"]}}}
