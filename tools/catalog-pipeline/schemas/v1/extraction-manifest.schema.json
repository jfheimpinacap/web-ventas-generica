{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"extraction-manifest.schema.json","type":"object","additionalProperties":false,"required":["schema_version","rules_version","engine_version","evidence_kind","identity_strategy","matching_fingerprint","binding_contract_version","binding_hash","adapters","rules","input_hashes","snapshot_hashes","output_hashes","sources","counts","structure_hash","status","blocking_reasons","artifacts","semantic_fingerprint","generated_at"],"properties":{"schema_version":{"const":"1.0.0"},"rules_version":{"type":"string"},"engine_version":{"const":"catalog-extraction-v1"},"evidence_kind":{"enum":["synthetic","live"]},"identity_strategy":{"const":"source-identity-v1"},"matching_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"binding_contract_version":{"const":"matching-extraction-binding-v1"},"binding_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"adapters":{"type":"array"},"rules":{"type":"array"},"input_hashes":{"type":"object"},"snapshot_hashes":{"type":"array"},"output_hashes":{"type":"object"},"sources":{"type":"array"},"counts":{"type":"object"},"structure_hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status":{"enum":["synthetic","complete","blocked"]},"blocking_reasons":{"type":"array"},"artifacts":{"type":"array"},"semantic_fingerprint":{"type":"string","pattern":"^[0-9a-f]{64}$"},"generated_at":{"type":["string","null"]}}}
